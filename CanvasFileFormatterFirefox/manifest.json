{
  "manifest_version": 3,
  "name": "Canvas File Formatter",
  "version": "1.4",
  "description": "Modifies the Canvas file viewer to remove unnecessary space.",
  "icons": {
    "48": "images/canvas.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-file-formatter@addons.mozilla.org",
      "data_collection_permissions": {
        "required": ["none"],
        "collects_personal_data": false,
        "collects_browsing_data": false
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://canvas.ku.edu/courses/*/files/*",
        "https://canvas.ku.edu/courses/*/pages/*"
      ],
      "js": ["scripts/content.js"],
      "css": ["style.css"]
    }
  ],
  "host_permissions": [
    "https://canvas.ku.edu/*"
  ]
}
